{
    "name": "rust-worker-otel-sample",
    "version": "1.0.0",
    "description": "Azure Functions TypeScript app on the Rust worker with opt-in OpenTelemetry http and dns instrumentation",
    "private": true,
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "start": "func start"
    },
    "main": "dist/{index.js,src/functions/*.js}",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@azure/functions": "^4.17.1",
        "@azure/functions-opentelemetry-instrumentation": "^0.3.0",
        "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.32",
        "@opentelemetry/api": "~1.9.0",
        "@opentelemetry/instrumentation": "^0.223.1",
        "@opentelemetry/instrumentation-dns": "^0.66.0",
        "@opentelemetry/instrumentation-http": "^0.223.1",
        "@opentelemetry/resources": "~2.12.1",
        "@opentelemetry/sdk-logs": "^0.223.1",
        "@opentelemetry/sdk-trace-node": "~2.12.1",
        "axios": "^1.21.1"
    }
}
